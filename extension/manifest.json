{
  "manifest_version": 3,
  "name": "RSVP4Dingus Paste Helper",
  "version": "1.0.0",
  "description": "Right-click selected text on any page and send it straight to RSVP4Dingus.",
  "permissions": ["contextMenus", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://dingus-droid.github.io/brotherboard/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://dingus-droid.github.io/brotherboard/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
